{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Idea Lab",
  "version": "0.1.0",
  "identifier": "com.idealab.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Idea Lab",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local dashboard for finding and validating business ideas",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyNDZGMDhFNDEwQjJCM0UKUldRK0t3dEJqdkJHWXRGWUZ4Q2l5M0dHTk9uS3Jmam16aTdQeU1qblpDaHo1eS9PZzBPV0FYQjYK",
      "endpoints": [
        "https://github.com/vicuvi1/idea-lab-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
